{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "npx -y figma-developer-mcp --figma-api-key=\"$(sed -n 's/^TOKEN_FIGMA=//p' .env)\" --stdio"
      ],
      "cwd": ".",
      "enabled": true,
      "environment": {
        "FIGMA_API_KEY": ""
      }
    }
  }
}
